{
  "name": "@tobi/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:watch": "node --env-file-if-exists=.env --watch dist/main.js"
  },
  "dependencies": {
    "@tobi/contracts": "workspace:*",
    "@tobi/game-data": "workspace:*",
    "@tobi/database": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@fastify/helmet": "13.1.1",
    "fastify": "5.12.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.4"
  }
}
